# Copy to your host (e.g. /etc/magnus.env) — do not commit real values.
# Use with: NODE_ENV=production node --env-file=/path/to/env dist/index.js
# Or set these in your process manager / container env block.

NODE_ENV=production
LOG_LEVEL=info

ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

MAGNUS_SUPABASE_DB_TIMEOUT_MS=30000
MAGNUS_ANTHROPIC_TIMEOUT_MS=120000
MAGNUS_ANTHROPIC_MAX_RETRIES=2

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

HEALTH_PORT=8080
MAGNUS_RATE_LIMIT_PER_MINUTE=30

# Production: usually false; enable specific users via DB or admin flow
MAGNUS_AUTO_ALLOWLIST_NEW_USERS=false
MAGNUS_DEFAULT_USER_TIER=standard
