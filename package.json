{
  "name": "magnus",
  "version": "0.0.1",
  "description": "Magnus — orchestrator agent",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:wiring": "vitest run src/agents/magnusToolWiring.test.ts src/agents/tools/magnusActionDetect.test.ts src/agents/routing/magnusToolContinuation.test.ts src/agents/orchestratorIntent.test.ts",
    "test:watch": "vitest",
    "test:supabase": "tsx scripts/test-supabase.mts",
    "db:apply": "tsx scripts/apply-sql-migration.mts",
    "telegram:check": "tsx scripts/telegram/setup.mts",
    "telegram:setup": "tsx scripts/telegram/setup.mts --apply",
    "google-calendar:auth": "tsx scripts/google-calendar-auth.mts",
    "youtube:auth": "tsx scripts/youtube-auth.mts",
    "kite:test-write": "tsx scripts/wealth/kite/test-write-endpoints.mts",
    "start:prod": "node --env-file=.env dist/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@notionhq/client": "^2.3.0",
    "@supabase/supabase-js": "^2.49.1",
    "@upstash/redis": "^1.34.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^173.0.0",
    "node-cron": "^4.2.1",
    "pino": "^9.6.0",
    "telegraf": "^4.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "pg": "^8.22.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
