{
  "name": "magnus",
  "version": "1.0.0",
  "description": "Magnus — personal health coach PWA (chat + tracker) on Anthropic SDK, Supabase and Hevy",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:prod": "node --env-file=.env dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:apply": "tsx scripts/apply-sql-migration.mts",
    "app:setup": "tsx scripts/health-app-setup.mts",
    "evals": "tsx src/healthApp/evals/run.mts",
    "evals:session": "tsx src/healthApp/evals/session.mts",
    "secrets:encrypt": "tsx scripts/encrypt-stored-secrets.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@supabase/supabase-js": "^2.49.1",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "heic-decode": "^2.1.0",
    "jpeg-js": "^0.4.4",
    "pino": "^9.6.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.20.0",
    "@types/web-push": "^3.6.4",
    "pg": "^8.22.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "qs": "^6.17.1"
  }
}
