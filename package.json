{
  "name": "magnus",
  "version": "1.0.0",
  "description": "Magnus — personal health coach PWA (chat + tracker) on Anthropic SDK, Supabase and Hevy",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:prod": "node --env-file=.env dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:apply": "tsx scripts/apply-sql-migration.mts",
    "app:setup": "tsx scripts/health-app-setup.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@supabase/supabase-js": "^2.49.1",
    "@upstash/redis": "^1.34.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pino": "^9.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.20.0",
    "pg": "^8.22.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
