# Copy to your host (e.g. /etc/magnus.env) — do not commit real values.
# Use with: NODE_ENV=production node --env-file=/path/to/env dist/index.js
# Or set these in your process manager / container env block.

NODE_ENV=production
LOG_LEVEL=info

ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

MAGNUS_SUPABASE_DB_TIMEOUT_MS=30000
MAGNUS_ANTHROPIC_TIMEOUT_MS=120000
MAGNUS_ANTHROPIC_MAX_RETRIES=2

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# VPS / Compose only. On Railway, Render, or Fly leave HEALTH_PORT unset so the app binds the
# platform's injected PORT — otherwise the healthcheck hits a port nothing is listening on.
HEALTH_PORT=8080
MAGNUS_RATE_LIMIT_PER_MINUTE=30

# Always-on host: Telegram posts updates instead of this process polling them. The URL is derived
# from RAILWAY_PUBLIC_DOMAIN / RENDER_EXTERNAL_URL / FLY_APP_NAME, so generate the public domain
# first, then redeploy. See docs/TELEGRAM_SETUP.md.
MAGNUS_TELEGRAM_MODE=webhook

# Production: usually false; enable specific users via DB or admin flow
MAGNUS_AUTO_ALLOWLIST_NEW_USERS=false
MAGNUS_DEFAULT_USER_TIER=standard
