# Copy to .env and fill in. `npm run telegram:check` reports which capabilities each key unlocks;
# full walkthrough in docs/TELEGRAM_SETUP.md.
NODE_ENV=development
LOG_LEVEL=info

# ── Required to boot ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TELEGRAM_BOT_TOKEN=

# Anon key is accepted locally but blocked by RLS on most tables; service role is the real one.
SUPABASE_ANON_KEY=

# New Telegram users need this to be "true" to get allowlisted automatically.
MAGNUS_AUTO_ALLOWLIST_NEW_USERS=true
# standard | premium | internal
MAGNUS_DEFAULT_USER_TIER=standard

# ── Google Calendar (platform OAuth app — shared across users) ─────────────────
# Set GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET on the host (e.g. Railway).
# Each user's refresh token lives in Supabase `user_integrations` — NOT here in production.
# Local auth flow:
#   export GOOGLE_OAUTH_CREDENTIALS=/path/to/client_secret.json
#   npm run google-calendar:auth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_CREDENTIALS=/absolute/path/to/client_secret.json
# GOOGLE_CALENDAR_TOKEN_PATH=~/.config/magnus/google-calendar-token.json
# Public HTTPS base for OAuth callbacks (YouTube connect-in-chat). Derived from Railway/Render/Fly
# when unset. Must match an authorized redirect URI on a Web OAuth client:
#   {MAGNUS_PUBLIC_BASE_URL}/oauth/google/callback
# MAGNUS_PUBLIC_BASE_URL=https://your-app.up.railway.app

# GOOGLE_YOUTUBE_TOKEN_PATH=~/.config/magnus/google-youtube-token.json
# YOUTUBE_REGION_CODE=US
# YOUTUBE_MAGNUS_PLAYLIST_TITLE=Magnus

# ── Per-user integrations (local .env for scripts only — stored in Supabase) ───
# Do not set these on Railway. Use:
#   TELEGRAM_USER_ID=<id> npx tsx scripts/upsert-user-integrations.mts
# GOOGLE_CALENDAR_REFRESH_TOKEN=
# GOOGLE_YOUTUBE_REFRESH_TOKEN=   # from npm run youtube:auth — per user, not a host secret
# HEVY_API_KEY=
# NOTION_TOKEN=
# NOTION_DAILY_LOG_PARENT_PAGE_ID=
# NOTION_MORNING_BRIEF_PARENT_PAGE_ID=
# NOTION_GOALS_DATABASE_ID=
# NOTION_DAILY_CHECKINS_DATABASE_ID=

# ── Health: meals ──────────────────────────────────────────────────────────────
# Estimate order: Anthropic web_search → USDA FDC → CalorieNinjas → optional Claude JSON.
# USDA_FDC_API_KEY — https://fdc.nal.usda.gov/api-key-signup
# CALORIENINJAS_API_KEY — https://calorieninjas.com/api
# USDA_FDC_API_KEY=
# CALORIENINJAS_API_KEY=
# MAGNUS_MEAL_LOG_WEB_FIRST=true          # false skips the web_search step
# MAGNUS_MEAL_ANTHROPIC_WEB_SEARCH=true   # requires web search enabled in the Claude Console
# MAGNUS_MEAL_LOG_LLM_FALLBACK=false      # true lets Claude guess when every source fails

# ── Notion display tuning (platform defaults; tokens are per-user in Supabase) ─
# NOTION_LOG_TITLE_PREFIX=Magnus Log
# NOTION_PAGE_TITLE_PROPERTY=title
# NOTION_MORNING_BRIEF_TITLE_PROPERTY=title
# NOTION_CHECKIN_DATE_PROPERTY=Date
# NOTION_GOALS_TITLE_PROPERTY=Name
# SKIP_NOTION_INTEGRATION=true

# ── Morning Brief (Magnus's proactive daily push) ───────────────────────────────
# Asking Magnus about your day works regardless; this is the unprompted 7am message.
# MAGNUS_MORNING_BRIEF_ENABLED=true
# MAGNUS_MORNING_BRIEF_CRON_ENABLED=false
# MAGNUS_MORNING_BRIEF_LOCAL_HOUR=7
# MAGNUS_MORNING_BRIEF_WINDOW_MINUTES=14
# MAGNUS_INTERNAL_JOB_SECRET=
# MAGNUS_MORNING_BRIEF_DEFAULT_USER_PROFILE_ID=
# Proactive sends use user_profile.telegram_chat_id — no TELEGRAM_CHAT_ID env needed.

# ── Telegram delivery and hosting ──────────────────────────────────────────────
# polling (default) — this process long-polls. Works anywhere, but only ONE process may poll a
#                     token, so overlapping deploys cause 409 Conflict.
# webhook           — Telegram posts to the health server. Best on an always-on host.
# On Railway / Render / Fly the public URL is derived automatically.
# MAGNUS_TELEGRAM_MODE=webhook
# TELEGRAM_WEBHOOK_URL=https://your-app.up.railway.app
# TELEGRAM_WEBHOOK_SECRET=                # derived from the bot token when unset

# Watchdog: probes Telegram on an interval and exits (so the host restarts) after N failures.
# MAGNUS_TELEGRAM_WATCHDOG_INTERVAL_MS=60000
# MAGNUS_TELEGRAM_WATCHDOG_FAILURES=5

# Telegraf aborts a turn after this long. Its own 90s default is too short for tool-using turns.
# MAGNUS_TELEGRAM_HANDLER_TIMEOUT_MS=300000

# HTTP: GET /health (liveness), GET /ready (Supabase + Redis). Leave unset on Railway/Render.
HEALTH_PORT=8080

# Inbound messages per user per minute (Redis fixed window). 0 = disabled.
MAGNUS_RATE_LIMIT_PER_MINUTE=30

# ── Memory / conversation context (tunable) ───────────────────────────────────
# Phase 1 — verbatim chat history in messages[] (not 160-char snippets).
# MAGNUS_MEMORY_CONVERSATION_MESSAGES=true
# MAGNUS_MEMORY_VERBATIM_TURNS=14
# MAGNUS_MEMORY_CHAT_FETCH_LIMIT=48
# MAGNUS_MEMORY_TURN_CONTENT_MAX_CHARS=4000
# Phase 2 — summary buffer for turns older than the verbatim window.
# MAGNUS_MEMORY_SUMMARY_BUFFER=true
# MAGNUS_MEMORY_SUMMARY_MAX_CHARS=2500
# MAGNUS_MEMORY_SUMMARY_PERSIST=true
# MAGNUS_MEMORY_SUMMARY_GENERATE_ON_MISS=true
# MAGNUS_MEMORY_SUMMARY_MODEL=claude-haiku-4-5
# Phase 3 — extract durable facts after each turn → memory_summaries (period=semantic_facts).
# MAGNUS_MEMORY_SEMANTIC_EXTRACT=true
# MAGNUS_MEMORY_SEMANTIC_PERSIST=true
# MAGNUS_MEMORY_SEMANTIC_MODEL=claude-haiku-4-5
# MAGNUS_MEMORY_SEMANTIC_FACTS_MAX=12
# Phase 4 — intent/query-aware memory slices + structured block (tuned: more context).
# MAGNUS_MEMORY_ADAPTIVE_RETRIEVAL=true
# MAGNUS_MEMORY_BLOCK_MAX_CHARS=6000
# MAGNUS_MEMORY_INCLUDE_GAPS=false
# MAGNUS_MEMORY_DAILY_LOG_SNIPPET_CHARS=400
# MAGNUS_MEMORY_DAILY_LOGS_IN_BLOCK=6
# MAGNUS_MEMORY_EVENTS_IN_BLOCK=8

# ── Client tuning ──────────────────────────────────────────────────────────────
MAGNUS_SUPABASE_DB_TIMEOUT_MS=30000
MAGNUS_ANTHROPIC_TIMEOUT_MS=120000
MAGNUS_ANTHROPIC_MAX_RETRIES=2
