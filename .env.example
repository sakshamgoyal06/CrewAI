# Copy to .env and fill in. `npm run telegram:check` reports which capabilities each key unlocks;
# full walkthrough in docs/TELEGRAM_SETUP.md.
NODE_ENV=development
LOG_LEVEL=info

ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PostgREST request timeout (ms)
MAGNUS_SUPABASE_DB_TIMEOUT_MS=30000

# Anthropic client (ms per attempt; retries multiply worst-case wait)
MAGNUS_ANTHROPIC_TIMEOUT_MS=120000
MAGNUS_ANTHROPIC_MAX_RETRIES=2

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# How updates arrive (docs/TELEGRAM_SETUP.md → "Keeping it always on"):
#   polling (default) — this process long-polls Telegram. Works anywhere, but only ONE process
#                       may poll a token, so overlapping deploys cause 409 Conflict.
#   webhook           — Telegram posts to the health server. Best for an always-on host: no
#                       conflicts on redeploy and Telegram retries when the host blips.
# On Railway / Render / Fly the public URL is derived automatically; elsewhere set
# TELEGRAM_WEBHOOK_URL to the https base URL of the deploy.
# MAGNUS_TELEGRAM_MODE=webhook
# TELEGRAM_WEBHOOK_URL=https://your-app.up.railway.app
# TELEGRAM_WEBHOOK_SECRET=            # optional; derived from the bot token when unset

# Watchdog: probes the Telegram API every interval and exits (so the host restarts) after N
# consecutive failures. Also re-registers a drifted webhook. 0 disables.
# MAGNUS_TELEGRAM_WATCHDOG_INTERVAL_MS=60000
# MAGNUS_TELEGRAM_WATCHDOG_FAILURES=5

# Telegram native command menu (see docs/TELEGRAM_SETUP.md):
#   core (default) — /menu, /help + everyday lanes (meal, journal, health, workouts, hevy, plan,
#                    research, morningbrief)
#   minimal        — /menu, /help, /meal only; drive the rest from the /menu inline picker
#   full           — every lane
# Apply changes with: npm run telegram:setup
# MAGNUS_TELEGRAM_COMMANDS_MODE=core

# Notion (server-side; headless bot cannot use Cursor MCP)
# NOTION_TOKEN=secret_...
# Optional: map LifeOS databases/pages (UUIDs from Notion → Copy link)
# NOTION_GOALS_DATABASE_ID=
# NOTION_DAILY_CHECKINS_DATABASE_ID=
# NOTION_PATTERNS_DATABASE_ID=
# NOTION_DAILY_LOG_PARENT_PAGE_ID=
# NOTION_CHECKIN_DATE_PROPERTY=Date
# NOTION_GOALS_TITLE_PROPERTY=Name
# NOTION_PAGE_TITLE_PROPERTY=title
# NOTION_LOG_TITLE_PREFIX=Magnus Log
# SKIP_NOTION_INTEGRATION=true

# HTTP: GET /health (liveness), GET /ready (Supabase + Redis)
HEALTH_PORT=8080

# Inbound Telegram messages per user per minute (sliding 60s window via Redis). 0 = disabled.
MAGNUS_RATE_LIMIT_PER_MINUTE=30

# When true (default), Telegram sends a short notice as soon as intent is classified and Magnus
# hands off to a specialist (before memory load and before that specialist runs). Set to false
# for mass scale (fewer messages per turn).
MAGNUS_DELEGATION_NOTICE=true

# New Telegram users: must be "true" to get allowlisted=true (safe default for production).
MAGNUS_AUTO_ALLOWLIST_NEW_USERS=true
# standard | premium | internal
MAGNUS_DEFAULT_USER_TIER=standard

# Memory agent (`src/agents/memory/`): uses the same Supabase credentials as the rest of the server.
# No separate env vars until semantic recall (pgvector / reflection embeddings RPC) is wired.

# Hevy (Fitness context) — Pro API key from https://hevy.com/settings?developer
# Docs: https://api.hevyapp.com/docs/ — optional; when set, Fitness loads recent sessions + routines from Hevy before Supabase `workouts`.
# Writes: `hevy routine:` (create), `hevy routine update: <uuid> — …` (PUT replace), `hevy workout:` (log), or `/hevy …` with the same payloads.
HEVY_API_KEY=afd9e93e-3a62-4fa3-b1b5-fc354b15f932
# Optional override (default https://api.hevyapp.com): MAGNUS_HEVY_API_BASE_URL=
# Optional HTTP timeout ms: MAGNUS_HEVY_FETCH_TIMEOUT_MS=15000

# Health program memory for Telegram (user-context, recovery-routine, journals).
# Default: .cursor/skills/health/references (bundled in Docker image).
# MAGNUS_HEALTH_REFERENCES_DIR=

# Meal logging — HEALTH router + meal parser. Nutrition estimate order:
# 1) Web research: Anthropic Messages API **web_search** tool (default; enable in Claude Console → Privacy), then SerpAPI + page excerpts + Claude if the first path fails and a Serp key is set — when MAGNUS_MEAL_LOG_WEB_FIRST is not false
# 2) USDA FDC, 3) Healthify proxy, 4) CalorieNinjas, 5) optional LLM JSON (MAGNUS_MEAL_LOG_LLM_FALLBACK)
# CALORIENINJAS_API_KEY — https://calorieninjas.com/api (fallback natural-language query)
# USDA_FDC_API_KEY — https://fdc.nal.usda.gov/api-key-signup
# Optional: HEALTHIFYME_PROXY_URL (+ HEALTHIFYME_PROXY_TOKEN)
# Optional: MAGNUS_MEAL_LOG_LLM_FALLBACK=true — Claude JSON if everything else fails
# Optional: MAGNUS_MEAL_LOG_WEB_FIRST=false — skip web-first path (Anthropic web_search + Serp fallback)
# Optional: MAGNUS_MEAL_ANTHROPIC_WEB_SEARCH=false — skip Anthropic web_search only (use SerpAPI path if key set)
# CALORIENINJAS_API_KEY=
# USDA_FDC_API_KEY=
# HEALTHIFYME_PROXY_URL=
# HEALTHIFYME_PROXY_TOKEN=
# MAGNUS_MEAL_LOG_LLM_FALLBACK=false
# MAGNUS_MEAL_LOG_WEB_FIRST=true

# SerpAPI — required for meal **web-first** estimates (same key as research agent)
# (https://serpapi.com/). Fetch timeout/size caps also apply.
# MAGNUS_SERPAPI_KEY=
# SERPAPI_API_KEY=
# MAGNUS_RESEARCH_FETCH_TIMEOUT_MS=15000
# MAGNUS_RESEARCH_MAX_RESPONSE_BYTES=2097152

# Google Calendar MCP (Cursor) — see docs/GOOGLE_CALENDAR_MCP.md
# GOOGLE_OAUTH_CREDENTIALS=/absolute/path/to/google-oauth-client-secret.json
# GOOGLE_CALENDAR_TOKEN_PATH=~/.config/magnus/google-calendar-token.json

# Morning Brief (LifeOS ritual) — see magnus.md
# MAGNUS_MORNING_BRIEF_ENABLED=true
# MAGNUS_MORNING_BRIEF_CRON_ENABLED=false
# MAGNUS_MORNING_BRIEF_LOCAL_HOUR=7
# MAGNUS_MORNING_BRIEF_WINDOW_MINUTES=14
# MAGNUS_INTERNAL_JOB_SECRET=
# MAGNUS_MORNING_BRIEF_DEFAULT_USER_PROFILE_ID=
# NOTION_TOKEN=
# NOTION_MORNING_BRIEF_PARENT_PAGE_ID=
# NOTION_MORNING_BRIEF_TITLE_PROPERTY=title
