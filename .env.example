# Magnus health app. Copy to .env for local dev; on Railway set these as service variables.
NODE_ENV=development

# --- Required ---
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- App access (npm run app:setup prints both) ---
# Long random token the app and phone automations send as `Authorization: Bearer <token>`.
MAGNUS_HEALTH_APP_TOKEN=
# user_profile.id the token acts as (single-user app).
MAGNUS_HEALTH_APP_USER_PROFILE_ID=
# Push notifications (npm run app:setup prints a pair). Without them the app works, just no pushes.
MAGNUS_VAPID_PUBLIC_KEY=
MAGNUS_VAPID_PRIVATE_KEY=
MAGNUS_VAPID_SUBJECT=mailto:you@example.com
# MAGNUS_HEALTH_APP_DIR=pwa                  # static files dir (default ./pwa)
# MAGNUS_HEALTH_CHAT_MODEL=claude-opus-5-5   # coach chat model

# --- Stored secrets ---
# 32 random bytes (openssl rand -hex 32). Seals each person's Hevy key in the database.
# Keep it safe: losing it means everyone reconnects Hevy. Then run `npm run secrets:encrypt` once.
# MAGNUS_SECRETS_KEY=

# --- Hevy ---
# Each person connects their own key in the app (You → Food, connections & account).
# HEVY_API_KEY=                              # fallback for the single owner

# --- Meal estimates (tried in this order) ---
# MAGNUS_MEAL_LOG_WEB_FIRST=true             # false skips the Claude web_search step
# MAGNUS_MEAL_ANTHROPIC_WEB_SEARCH=true      # requires web search enabled in the Claude Console
# USDA_FDC_API_KEY=
# CALORIENINJAS_API_KEY=
# MAGNUS_MEAL_LOG_LLM_FALLBACK=false         # true lets Claude estimate when every source fails

# --- Server ---
# PORT=8080                                  # Railway injects PORT; leave HEALTH_PORT unset there
# LOG_LEVEL=info
# MAGNUS_SUPABASE_DB_TIMEOUT_MS=30000
# MAGNUS_ANTHROPIC_TIMEOUT_MS=120000
# MAGNUS_ANTHROPIC_MAX_RETRIES=2
